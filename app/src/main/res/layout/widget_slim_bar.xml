<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_slim_bar"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Subtle Heading -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#D9AC46"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="3dp"
        android:singleLine="true"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/app_name" />

    <!-- 4 Equal Action Columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- Action 1: Cash In -->
        <LinearLayout
            android:id="@+id/widget_action_cash_in"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:contentDescription="@string/widget_action_cash_in">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_cash_in"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_action_cash_in"
                android:textColor="#F6F2E9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:ellipsize="none"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Action 2: Cash Out -->
        <LinearLayout
            android:id="@+id/widget_action_cash_out"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:contentDescription="@string/widget_action_cash_out">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_cash_out"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_action_cash_out"
                android:textColor="#F6F2E9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:ellipsize="none"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Action 3: New Bill -->
        <LinearLayout
            android:id="@+id/widget_action_new_bill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:contentDescription="@string/widget_action_new_bill">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_new_bill"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_action_new_bill"
                android:textColor="#F6F2E9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:ellipsize="none"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- Action 4: Add Stock -->
        <LinearLayout
            android:id="@+id/widget_action_add_stock"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_item"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:contentDescription="@string/widget_action_add_stock">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_add_stock"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_action_add_stock"
                android:textColor="#F6F2E9"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:ellipsize="none"
                android:importantForAccessibility="no" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
